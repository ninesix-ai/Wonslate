<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Wonslate</AssemblyName>
    <RootNamespace>Wonslate</RootNamespace>
    <Authors>ninesix-ai studio</Authors>
    <Company>ninesix-ai studio</Company>
    <Copyright>© 2026 ninesix-ai studio. All rights reserved.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ninesix-ai/Wonslate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- 引擎 DLL 输出策略：Rust 编译产物复制到本目录 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Single-file distribution knobs (GA-4). Scoped to an actual single-file publish so a plain
       `dotnet build -c Release` (which the authoritative gate runs, and which CI builds on every
       OS) is untouched: at build time PublishSingleFile is empty, so none of this applies and no
       win-x64 runtime pack is restored. `script/pack_installer.py publish` passes
       PublishSingleFile=true and -r win-x64; these defaults make a bare `dotnet publish` on a
       Windows host produce the same artifact without repeating every flag. Self-contained is
       deliberate: the air-gapped / restricted-egress host has no network to install a runtime. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 将 Rust cdylib 复制到输出目录 -->
    <None Include="..\translator-engine\target\release\translator_engine.dll"
          Link="translator_engine.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\translator-engine\target\release\translator_engine.dll')" />
  </ItemGroup>

  <ItemGroup>
    <!-- N-10: the voice pipeline (Audio/SherpaVoiceStages.cs) is the reference this
         dependency was waiting for (see the R6 note: sherpa was removed in the
         baseline cleanup as a dead dependency and is re-added here because code in
         this project now uses it). win-x64 only: the other platforms' native
         runtimes stay out of the artifact until the cross-platform client lands. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
  </ItemGroup>

</Project>
