<Window x:Class="Wonslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wonslate · 万邦译"
        Width="860" Height="760"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- Startup diagnostics: engine init ack + per-sidecar state -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#8a6d00"
                   TextWrapping="Wrap" Text="{Binding Diagnostics, Mode=OneWay}" />

        <!-- Top bar: engine version + routing label -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#666">
            Rust 引擎版本: <Run Text="{Binding EngineVersion, Mode=OneWay}" /> · 路由决策:
            <Run Text="{Binding EngineLabel, Mode=OneWay}" Foreground="#0a7d33" />
        </TextBlock>

        <!-- Busy indicator: visible only while a translation is in flight -->
        <ProgressBar DockPanel.Dock="Top" Height="4" IsIndeterminate="True" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibility}}" />

        <!-- Input area -->
        <GroupBox DockPanel.Dock="Top" Header="输入（Source）" Margin="0,0,0,8">
            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="80" VerticalScrollBarVisibility="Auto"
                     FontSize="16" Padding="6" />
        </GroupBox>

        <!-- Language-pair picker (decoupled source / target) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="源语言:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="130" ItemsSource="{Binding SourceLanguages}" DisplayMemberPath="DisplayName"
                      SelectedValuePath="Code" SelectedValue="{Binding SourceLang, Mode=TwoWay}" />
            <Button Content="⇄ 交换" Width="72" Margin="10,0" Click="ExchangeButton_Click"
                    IsEnabled="{Binding CanExchangeLanguages}"
                    ToolTip="交换源/目标语言（源语言为「自动检测」时不可用）" />
            <TextBlock Text="目标语言:" VerticalAlignment="Center" Margin="6,0,6,0" />
            <ComboBox Width="130" ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName"
                      SelectedValuePath="Code" SelectedValue="{Binding TargetLang, Mode=TwoWay}" />
        </StackPanel>

        <!-- Controls area -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="模式:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="120" SelectedIndex="0" SelectionChanged="ModeComboBox_SelectionChanged">
                <ComboBoxItem Content="实时档（Realtime）"/>
                <ComboBoxItem Content="精译档（Full）"/>
            </ComboBox>

            <CheckBox Content="隐私模式（强制离线）"
                      IsChecked="{Binding PrivacySensitive}"
                      VerticalAlignment="Center" Margin="24,0,0,0" />

            <Button Content="翻译" Width="110" Margin="24,0,0,0"
                    Click="TranslateButton_Click"
                    IsEnabled="{Binding IsNotBusy, Mode=OneWay}" />

            <Button Content="取消" Width="70" Margin="8,0,0,0"
                    Click="CancelButton_Click"
                    IsEnabled="{Binding IsBusy, Mode=OneWay}"
                    ToolTip="放弃本次翻译（引擎调用无法中断，结果会被丢弃）" />

            <Button Content="存入 TM" Width="90" Margin="10,0,0,0"
                    Click="SaveTmButton_Click"
                    ToolTip="把当前输入与译文作为用户确认的记忆对写入 TM" />
        </StackPanel>

        <!-- Output area -->
        <GroupBox DockPanel.Dock="Top" Header="输出（Target）" Margin="0,0,0,8">
            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="100" VerticalScrollBarVisibility="Auto"
                     FontSize="16" Padding="6" Foreground="#0a7d33" />
        </GroupBox>

        <!-- Operation feedback -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage, Mode=OneWay}"
                   Foreground="#0a7d33" TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#888" TextWrapping="Wrap"
                   Text="TM 与术语表按上方所选语言对查看；「标坏」的 TM 记录不再命中。离线翻译需要该语言对已安装本地模型（当前 en↔zh 走 Argos/CT2，安装见 script/fetch_argos_models.py）；未安装的语对会显式回落，上方标签显示「兜底降级」。" />

        <!-- TM / glossary management (N-07) -->
        <TabControl SelectionChanged="ManagementTab_SelectionChanged">
            <TabItem Header="TM 记忆库" Tag="tm">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="刷新" Width="80" Click="RefreshTmButton_Click" />
                        <Button Content="标坏所选（不再命中）" Width="170" Margin="10,0,0,0"
                                Click="FlagBadTmButton_Click" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding TmEntries}"
                              SelectedItem="{Binding SelectedTmEntry, Mode=TwoWay}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="源文" Width="260"
                                                DisplayMemberBinding="{Binding SourceText}" />
                                <GridViewColumn Header="译文" Width="260"
                                                DisplayMemberBinding="{Binding TargetText}" />
                                <GridViewColumn Header="引擎" Width="90"
                                                DisplayMemberBinding="{Binding Engine}" />
                                <GridViewColumn Header="命中" Width="60"
                                                DisplayMemberBinding="{Binding HitCount}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="设置" Tag="settings" DataContext="{Binding Settings}">
                <StackPanel Margin="6">
                    <TextBlock Text="质量与成本" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                               Text="选择精译档的行为。保存后需重启软件生效；下方显示引擎当前实际生效的配置。" />
                    <ListBox ItemsSource="{Binding Options, Mode=OneWay}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}" Height="118">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"
                                               Foreground="#666" FontSize="11" Width="720" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存" Width="90" Click="SettingsSaveButton_Click"
                                IsEnabled="{Binding HasUnsavedChange, Mode=OneWay}" />
                        <Button Content="重新读取" Width="90" Margin="8,0,0,0"
                                Click="SettingsReloadButton_Click" />
                        <TextBlock Text="保存后需重启软件生效" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="#b06" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="#8a6d00" Margin="0,8,0,0" />
                    <TextBlock Text="当前实际生效的配置（由引擎返回）" FontWeight="Bold" Margin="0,10,0,2" />
                    <TextBox Text="{Binding Effective, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" Height="86" Padding="4" Foreground="#0a5" />
                    <TextBlock Text="{Binding SettingsPath, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="#888" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="语音（离线）" Tag="voice" DataContext="{Binding Voice}">
                <StackPanel Margin="6">
                    <TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="#8a6d00" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="选择 WAV…" Width="100" Click="VoiceSelectButton_Click" />
                        <TextBlock Text="{Binding FilePath, Mode=OneWay}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="#555" TextTrimming="CharacterEllipsis"
                                   Width="330" />
                        <Button Content="识别并翻译" Width="110" Margin="10,0,0,0"
                                Click="VoiceRunButton_Click" IsEnabled="{Binding CanRun, Mode=OneWay}" />
                        <Button Content="播放译文" Width="90" Margin="10,0,0,0"
                                Click="VoicePlayButton_Click" IsEnabled="{Binding CanPlay, Mode=OneWay}" />
                    </StackPanel>
                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,6"
                                 Visibility="{Binding IsBusy, Mode=OneWay,
                                              Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="识别文本（ASR）" Foreground="#666" Margin="0,4,0,2" />
                    <TextBox Text="{Binding RecognizedText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" Height="44" Padding="4" />
                    <TextBlock Text="译文（TTS 合成目标语言语音）" Foreground="#666" Margin="0,6,0,2" />
                    <TextBox Text="{Binding TranslatedText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" Height="44" Padding="4" Foreground="#0a7d33" />
                    <TextBlock Text="{Binding TimingText, Mode=OneWay}" Foreground="#555"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Notes, Mode=OneWay}" Foreground="#b00"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="M3/M4 已打通：VAD 分段 → SenseVoice 识别 → 引擎翻译 → Kokoro 合成 → 播放。模型不在仓库内，见 script/fetch_voice_models.py。" />
                </StackPanel>
            </TabItem>

            <TabItem Header="术语表" Tag="glossary">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Width="180" Padding="4"
                                 Text="{Binding GlossarySourceTerm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="术语原文" />
                        <TextBlock Text="→" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Width="180" Padding="4"
                                 Text="{Binding GlossaryTargetTerm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="术语译文" />
                        <Button Content="新增/更新" Width="100" Margin="10,0,0,0"
                                Click="SaveGlossaryButton_Click" />
                        <Button Content="删除所选" Width="90" Margin="10,0,0,0"
                                Click="DeleteGlossaryButton_Click" />
                        <Button Content="刷新" Width="70" Margin="10,0,0,0"
                                Click="RefreshGlossaryButton_Click" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding GlossaryEntries}"
                              SelectedItem="{Binding SelectedGlossaryEntry, Mode=TwoWay}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="原文" Width="240"
                                                DisplayMemberBinding="{Binding SourceTerm}" />
                                <GridViewColumn Header="译文" Width="240"
                                                DisplayMemberBinding="{Binding TargetTerm}" />
                                <GridViewColumn Header="置信度" Width="80"
                                                DisplayMemberBinding="{Binding Confidence}" />
                                <GridViewColumn Header="来源" Width="80"
                                                DisplayMemberBinding="{Binding Source}" />
                                <GridViewColumn Header="频次" Width="60"
                                                DisplayMemberBinding="{Binding Frequency}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
